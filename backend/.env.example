# ============================================================
# Patient Portal backend — copy to backend/.env and fill in.
# Everything runs in safe dry-run mode until you connect things.
# ============================================================

# --- Practice identity (appears on receipts, forms, emails) ---
CLINIC_NAME="Your Clinic Name"
CLINIC_ADDRESS="123 Clinic Street, City"
CLINIC_PHONE="+1 (000) 000-0000"
CLINIC_EMAIL="billing@example.com"

# --- MongoDB >>> CONNECT <<< ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="patient_portal"

# --- Anthropic (powers all 6 agents) >>> CONNECT <<< ---
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=""

# --- Zoho Sheets >>> CONNECT <<< ---
# 1. Create a "Self Client" at https://api-console.zoho.com
# 2. Generate a code with scope: ZohoSheet.dataAPI.READ
# 3. Exchange it for a refresh token (see README) and paste below
# 4. ZOHO_SHEET_RESOURCE_ID is the id in your sheet URL:
#    https://sheet.zoho.com/sheet/open/<resource_id>
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_SHEET_RESOURCE_ID=""
# If your Zoho account is on another DC, change these (e.g. .zoho.in / .zoho.eu)
ZOHO_ACCOUNTS_BASE="https://accounts.zoho.com"
ZOHO_SHEET_API_BASE="https://sheet.zoho.com/api/v2"

# --- Email (SMTP — works with Zoho Mail, Gmail, SES...) >>> CONNECT <<< ---
# Zoho Mail example: host smtp.zoho.com, port 587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Keep true while testing: emails are captured in the Outbox instead of sent.
EMAIL_DRY_RUN="true"

CORS_ORIGINS="*"
